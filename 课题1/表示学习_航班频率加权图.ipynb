    "import networkx as nx\n",
    "\n",
    "# 创建一个空图\n",
    "G = nx.Graph()\n",
    "\n",
    "# 将城市作为节点，航班频数作为边的权重添加到图中\n",
    "for index, row in flight_counts.iterrows():\n",
    "    G.add_edge(row['from'], row['to'], weight=row['flight_count'])\n",
    "\n",
    "# 输出图的基本信息\n",
    "print(\"图的节点数:\", G.number_of_nodes())\n",
    "print(\"图的边数:\", G.number_of_edges())"
   ]
